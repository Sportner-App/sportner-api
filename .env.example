# Copy to .env and fill real values. Never commit .env.
ConnectionStrings__SupabaseConnection=Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
JwtSettings__Secret=YOUR_JWT_SECRET_AT_LEAST_32_CHARS
JwtSettings__Issuer=SportnerApi
JwtSettings__Audience=SportnerMobile
JwtSettings__ExpirationDays=7
Supabase__Url=https://YOUR_PROJECT.supabase.co
Supabase__ServiceRoleKey=YOUR_SERVICE_ROLE_KEY
Supabase__AvatarsBucket=avatars
