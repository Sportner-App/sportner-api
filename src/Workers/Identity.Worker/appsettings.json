{
  "BackgroundJobs": {
    "Enabled": true,
    "RunOnStartup": false,
    "SessionRetentionDays": 90,
    "SessionCleanupBatchSize": 500,
    "SessionCleanupCron": "0 3 * * *",
    "OtpCleanupCron": "0 * * * *"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
