{
  "BackgroundJobs": {
    "Enabled": true,
    "RunOnStartup": false,
    "EventReminderCron": "*/15 * * * *",
    "EventReminderWindowsMinutes": [ 1440, 60 ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
