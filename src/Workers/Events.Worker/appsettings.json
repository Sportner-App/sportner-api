{
  "BackgroundJobs": {
    "Enabled": true,
    "RunOnStartup": false,
    "EventCompletionCron": "*/5 * * * *",
    "EventCompletionBatchSize": 50,
    "EventSeriesCron": "*/10 * * * *",
    "EventSeriesBatchSize": 50,
    "EventReminderCron": "*/15 * * * *",
    "EventReminderWindowsMinutes": [ 1440, 60 ],
    "EngagementReminderCron": "0 15 * * *",
    "ChallengeCron": "5 * * * *",
    "DistrictLeaderCron": "20 * * * *",
    "MonthlyRecapCron": "35 * * * *",
    "MarathonRunnerBadgeCron": "0 4 * * *"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
