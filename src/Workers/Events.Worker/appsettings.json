{
  "BackgroundJobs": {
    "Enabled": true,
    "RunOnStartup": false,
    "EventReminderCron": "*/15 * * * *",
    "EventReminderWindowsMinutes": [ 1440, 60 ],
    "MarathonRunnerBadgeCron": "0 4 * * *"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
